<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CC_Required_Rejection_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status, &apos;Denied&apos;),
(ISPICKVAL(CC_Denial_Reason_Category__c,&apos;Other&apos;)||
ISPICKVAL(CC_Denial_Reason_Sub_Category__c,&apos;Other&apos;)
),
ISBLANK( CC_Rejection_Reason__c))</errorConditionFormula>
    <errorMessage>Please enter the Rejection Reason</errorMessage>
</ValidationRule>
